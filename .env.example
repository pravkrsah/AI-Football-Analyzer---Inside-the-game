# Copy this file to `.env` and fill in your own values. Do NOT commit `.env`.

# ── Azure OpenAI (chat) ─────────────────────────────────────────────────
AZURE_OPENAI_MODEL='gpt-4o'                 # your chat deployment name
AZURE_OPENAI_API_KEY='<your-azure-openai-key>'
AZURE_OPENAI_ENDPOINT='https://<your-resource>.openai.azure.com'
AZURE_OPENAI_API_VERSION='2024-05-01-preview'

# ── Azure OpenAI (embeddings) ───────────────────────────────────────────
AZURE_OPENAI_TEXT_EMBEDDING=text-embedding-ada-002   # embedding deployment name
AZURE_OPENAI_EMBEDDING_VERSION=2023-05-15            # required for ada-002
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-resource>.openai.azure.com

# ── API-Football v3 (optional — for Live/Replay mode) ───────────────────
# https://www.api-football.com -> Dashboard -> API Key
APIFOOTBALL_API_KEY=<your-api-football-key>
APIFOOTBALL_MAX_SEASON=2024                 # free plan caps at 2024; raise after upgrade
